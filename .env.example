# ─────────────────────────────────────────────────────────────────────────────
# InterviewSystem — environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider (pick one) ──────────────────────────────────────────────────

# OpenRouter (recommended — gives access to Kimi K2.6, DeepSeek, Llama, etc.)
OPENROUTER_API_KEY=

# Optional: override per-tier model (defaults shown)
# OPENROUTER_TOP_MODEL=moonshotai/kimi-k2.6
# OPENROUTER_MID_MODEL=deepseek/deepseek-v3
# OPENROUTER_CHEAP_MODEL=meta-llama/llama-3.1-8b-instruct

# OpenAI (fallback if OPENROUTER_API_KEY is not set)
# OPENAI_API_KEY=

# Optional: override per-tier OpenAI model (defaults shown)
# OPENAI_TOP_MODEL=gpt-4o
# OPENAI_MID_MODEL=gpt-4-turbo
# OPENAI_CHEAP_MODEL=gpt-4o-mini

# ── Dev / testing ─────────────────────────────────────────────────────────────

# Set to 1 to use the deterministic FakeRouter (no API key needed)
# FAKE_LLM=1

# ── App config ────────────────────────────────────────────────────────────────

# Directory where feedback markdown files are written (default: outputs/)
# OUTPUT_DIR=outputs

# SQLite database path (default: interview.db)
# DB_PATH=interview.db

# Voice UI: off | on | forced
# VOICE_MODE=off

# Voice latency soft budget for dashboard/reporting
# VOICE_LATENCY_BUDGET_MS=800

# Real voice providers (optional; fakes are used when unset)
# WISPR_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
