# ─────────────────────────────────────────────────────────────────────────────
# InterviewSystem — environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider ──────────────────────────────────────────────────────────────

# OpenAI is the only production LLM provider.
OPENAI_API_KEY=

# Single model used for every LLM task. "low" is the fast reasoning setting.
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low

# ── Dev / testing ─────────────────────────────────────────────────────────────

# Set to 1 to use the deterministic FakeRouter (no API key needed)
# FAKE_LLM=1

# ── App config ────────────────────────────────────────────────────────────────

# Directory where feedback markdown files are written (default: outputs/)
# OUTPUT_DIR=outputs

# SQLite database path (default: interview.db)
# DB_PATH=interview.db

# Voice UI: off | on | forced
# VOICE_MODE=off

# Voice latency soft budget for dashboard/reporting
# VOICE_LATENCY_BUDGET_MS=800

# Text-to-speech playback: off | on (default off; voice still accepts STT when off)
# TTS_MODE=off

# Real voice providers (optional; fakes are used when unset)
# WISPR_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=

# ── Intake / retention / internal ops ─────────────────────────────────────────

# Raw profile upload retention target. The current MVP documents this knob;
# background deletion workers are deferred to production hardening.
# PROFILE_RETENTION_DAYS=30

# Max resume upload size in bytes for the HTTP intake path.
# RESUME_MAX_BYTES=2000000

# Internal metrics endpoint is served at /internal/metrics. Put it behind
# network/auth controls before exposing beyond localhost/private networks.
